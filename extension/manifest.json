{
  "manifest_version": 3,
  "name": "Anti-Fraud Messaging Alert",
  "version": "1.1.0",
  "description": "即時偵測網頁版通訊軟體的高風險詐騙訊息",
  "content_scripts": [
    {
      "matches": ["https://www.messenger.com/*", "https://web.whatsapp.com/*", "https://www.instagram.com/*"],
      "js": ["content.js"]
    }
  ]
}
